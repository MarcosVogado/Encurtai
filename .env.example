# Copie para .env e preencha. O .env NÃO vai para o git (ver .gitignore).
#
#   cp .env.example .env
#
# Em produção estes valores vêm do Secrets Manager do CI/CD, nunca de arquivo.

# --- Banco ---
# A senha entra numa connection string: evite @ : / ? # & ou use percent-encoding.
MONGO_ROOT_USER=encurtai
MONGO_ROOT_PASSWORD=troque-esta-senha
MONGO_DATABASE=encurtai

# --- Endereço público ---
# Precisa ser o endereço pelo qual o NAVEGADOR alcança a aplicação, porque é o
# que vai dentro do link curto devolvido ao usuário.
PUBLIC_BASE_URL=http://localhost:8080

# --- Portas no host ---
WEB_PORT=8080
API_PORT=5080

# --- Imagem ---
# Para rodar uma versão publicada em vez de compilar local:
#   IMAGE_TAG=v1.1.0 docker compose pull && docker compose up -d --no-build
REGISTRY=ghcr.io/marcosvogado
IMAGE_TAG=dev

# --- Demonstração de rollback ---
# true faz /health/ready responder 503, reprovando a readinessProbe.
SIMULAR_FALHA=false
